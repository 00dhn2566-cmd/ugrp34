# Python bytecode
__pycache__/

# ultralytics 학습 산출물 (runs·가중치는 커밋 금지)
runs/
*.pt

# EuRoC MAV / large dataset files
visual_imaging_taemin/dataset/*
!visual_imaging_taemin/dataset/.gitkeep
!visual_imaging_taemin/dataset/README.md

# control_seoungjin: distribution zip / generated verification artifacts
control_seoungjin/*.zip
control_seoungjin/**/trajectory.mat
control_seoungjin/sample/sample_trajectory.png
control_seoungjin/sample/output/
# path_time 파이프라인 산출물 (traj_pipeline.py가 생성; attitude_feedback.json은
# 컨트롤러↔path_time 핸드셰이크 상태 파일이라 커밋 제외)
control_seoungjin/output/

# vision 학습 데이터셋 (로컬 전용, git 미포함)
window_dataset/

# 로컬 편집기 설정 (머신별 컴파일러 경로가 박혀 있어 공유 부적합)
.vscode/

# 루트 output/ = 스크립트를 repo 루트에서 돌렸을 때 생기는 생성물
# (make_equation_images.py 등 — 재생성 가능, 산출물은 control_seoungjin/ 아래가 규약)
/output/
